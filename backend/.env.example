# This file documents environment variables; the app reads the process environment.
EXAM_DATABASE_PATH=backend/data/exam.sqlite3
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8003,http://127.0.0.1:8003
# Used when initializing NEW sample questions only; existing exam snapshots are unchanged.
QUESTION_TIME_LIMIT_SECONDS=60
